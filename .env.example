APP_NAME=Game Web App
APP_ENV=development
DEBUG=true

# Database Configuration (supports 'postgres' or 'mongodb')
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/game_web_app

# MongoDB Future Provider Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=game_web_app

# JWT Security
SECRET_KEY=your-super-secret-key-min-32-chars

# URLs
FRONTEND_URL=http://localhost:5173

# Optional Vision AI API Key (e.g. OpenAI GPT-4 Vision)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

PORT=8000
